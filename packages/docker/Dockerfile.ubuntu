FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Update and install basic tools + CTF pentesting essentials
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Core
    bash \
    ca-certificates \
    git \
    curl \
    wget \
    sudo \
    # Networking
    nmap \
    netcat-openbsd \
    net-tools \
    iputils-ping \
    socat \
    redis-tools \
    # Web enumeration
    nikto \
    whatweb \
    dirb \
    gobuster \
    # Exploitation
    sqlmap \
    hydra \
    # Password cracking
    john \
    # Forensics
    binwalk \
    file \
    # Languages
    python3 \
    python3-pip \
    # Editors
    vim \
    nano \
    && rm -rf /var/lib/apt/lists/*

# Install Python CTF tools
RUN pip3 install --break-system-packages \
    requests \
    pwntools \
    pycryptodome

# Create non-root user
RUN useradd -m -s /bin/bash agent && \
    echo "agent:agent" | chpasswd && \
    usermod -aG sudo agent

# Create workspace directory
RUN mkdir -p /workspace && chown agent:agent /workspace

# Install Node.js for pi coding-agent
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*

# Install agent-aegis
RUN npm install -g --ignore-scripts @buckeyestudio/agent-aegis

# Create agent config directory
RUN mkdir -p /root/.aegis/agent

# Copy entrypoint
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
